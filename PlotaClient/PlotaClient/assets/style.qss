/* Base */
QWidget {
    font-family: "Segoe UI", "Inter", "Arial";
    font-size: 14px;
    background: #0f1115;
    color: #e8e8e8;
}

/* Titles / subtle */
QLabel#TitleLabel {
    font-size: 24px;
    font-weight: 700;
}
QLabel#SubtleLabel {
    color: #a7b0bf;
}
QLabel#ErrorLabel {
    color: #ff6b6b;
}

/* Status labels you already have */
QLabel[name^="lbl"][name$="Status"], QLabel#lblLoginStatus, QLabel#lblSignupStatus,
QLabel#lblForgotStatus, QLabel#lblEditProfileStatus {
    color: #a7b0bf;
}

/* Inputs */
QLineEdit {
    background: #171a21;
    border: 1px solid #2a2f3a;
    border-radius: 10px;
    padding: 8px 10px;
    selection-background-color: #3b82f6;
}
QLineEdit:focus {
    border: 1px solid #3b82f6;
}

/* Buttons */
QPushButton {
    background: #1b2230;
    border: 1px solid #2a3446;
    border-radius: 10px;
    padding: 8px 14px;
}
QPushButton:hover {
    background: #222c3d;
    border: 1px solid #3a4762;
}
QPushButton:pressed {
    background: #121826;
    border: 1px solid #3b82f6;
}
QPushButton:disabled {
    color: #6b7280;
    background: #131722;
    border: 1px solid #1f2532;
}

/* “Primary” button style via objectName */
QPushButton#PrimaryButton {
    background: #2563eb;
    border: 1px solid #3b82f6;
    font-weight: 600;
}
QPushButton#PrimaryButton:hover {
    background: #2f74ff;
}
QPushButton#PrimaryButton:pressed {
    background: #1e4bb8;
}

/* Progress bar */
QProgressBar {
    background: #171a21;
    border: 1px solid #2a2f3a;
    border-radius: 6px;
}
QProgressBar::chunk {
    background: #2563eb;
    border-radius: 6px;
}

QPushButton:pressed {
    padding-top: 10px;   /* makes content look lower */
    padding-bottom: 6px;
}

QWidget:not(#toast) {
    font-family: "Segoe UI", "Inter", "Arial";
    font-size: 14px;
    background: #0f1115;
    color: #e8e8e8;
}

